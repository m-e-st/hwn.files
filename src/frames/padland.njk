---
layout: base.njk
date: 2026-10-13

secret:
    min: 3
    len: 6
    init: 4
name:
    min: 4    

groups:
  - cafe
  - digis
  - fvsbo
  - hwn
  - luise
  - privat

---

<style>
    /* Kleiner Fix, um Select und Input exakt gleich hoch zu machen */
    .ms-pale-theme.w3-select {
        padding-top: 8px;
        padding-bottom: 8px;
        height: 40px; /* Alternativ: feste Höhe für beide Felder */
        box-sizing: border-box;
    }
    .ms-pale-theme.w3-input {
        height: 40px; /* Gleiche feste Höhe für Inputs */
        box-sizing: border-box;
    }
    
#newpadForm input,
#newpadForm select {
    transition: background-color .15s ease;
}

#newpadForm input:focus,
#newpadForm select:focus {
    -moz-outline-radius: 0;
    outline: none;
    background-color: {{color.theme.light|d('#FFF8B8')}}!important
}
</style>


<main class="w3-large">
	<details class="w3-panel ms-pale-theme w3-padding w3-justify" style="margin-top:0px;">
		<summary>Neues Etherpad anlegen</summary>
		<p>
			Die Anlage neuer Etherpads direkt auf dem Server 
			<a class="w3-tag" href="https://pad.hwn.de" target="{{site.target}}">pad.hwn.de</a> 
			ist wegen Vandalismus vorübergehend gesperrt.
			Neue Etherpads können nur noch über dieses Formular erzeigt werden. werden.
			der Aufruf bestehender Etherpads ist weiterhin direkt möglich.
		</p>
	</details>
	
	<form id="newpadForm" class="w3-container">
		<div class="w3-row">
			<div class="w3-col s12 m2 l1">
				<label class="ms-logotext w3-small"><b>Gruppe</b></label>
				<select class="w3-select w3-border ms-pale-theme x-w3-center" name="newpadGroup" id="newpadGroup">
					<option value="" selected>&nbsp;</option>
					{% for group in groups %}
						<option value="{{group}}" >&nbsp;{{group}}</option>
					{% endfor %}
				</select>
			</div>
			<div class="w3-col s12 m6 l8">
				<label class="ms-logotext w3-small"><b>Name</b></label>
				<input class="w3-input w3-border ms-pale-theme" type="text" name="newpadName" placeholder="Name des Pad" id="newpadName">
			</div>
			<div class="w3-col s12 m4 l3">
				<label class="ms-logotext w3-small"><b>Secret <i id="newpadRecycle" class="w3-large w3-right" style="cursor: pointer;" title="Secret neu generieren">⟳&nbsp;</i></b></label>
				<input class="w3-input w3-border ms-pale-theme" type="text" name="newpadSecret" placeholder="Secret" id="newpadSecret">
			</div>
		</div>

		<div class="w3-row">
			<div class="w3-col s12 m5 l4">
				<label class="ms-logotext w3-small"><b>Etherpad</b></label>
				<input class="w3-input w3-border ms-pale-theme" type="text" name="newpadEther" placeholder="… wird ermittelt …" id="newpadEther" readonly>
			</div>
			<div class="w3-col s12 m7 l8">
				<label class="ms-logotext w3-small"><b>URL</b></label>
				<input class="w3-input w3-border ms-pale-theme w3-monospace" type="text" name="newpadURL" placeholder="" id="newpadURL" readonly>
			</div>
		</div>

		<div class="w3-section w3-left">
			<button type="reset"  id="newpadReset"  class="w3-btn w3-medium-gray" style="width:8rem">Reset</button>
			<button type="button" id="newpadOpen" class="w3-btn ms-light-theme" style="width:8rem">Öffnen</button>
			<button type="submit" id="newpadSubmit" class="w3-btn ms-theme" style="width:8rem">Anlegen</button>
			<output class="w3-mobile w3-margin-left w3-text-medium-gray" id="newpadResult">error</output>
		</div>
	</form>
		
	<details class="w3-panel ms-pale-theme w3-padding w3-justify" style="margin-top:0px;">
		<summary>Gespeicherte Etherpads</summary>
		<p class="w3-deep-orange w3-padding w3-center">Momentan gibt es noch keine Verwaltung von Etherpad-Namen</p>
	</details>
		
	<details class="w3-panel ms-pale-theme w3-padding w3-justify" style="margin-top:0px;">
		<summary>Erläuterungen</summary>
		<p>
			Die Etherpad-Seite wurde in der Vergangenheit massiv mit Spam und illegalen Inhalten geflutet.
			Dennoch sollen die Etherpads weiterhin anonym ohne Registrierung oder Anmeldung benutzbar sein.
			Dazu wird ein Namenschema eingeführt, welches zukünftig die automatische Bereinigung der Etherpad-Plattform ermöglicht.
		</p><p>
			Etherpads müssen zukünftig dem Namenschema «Gruppe-Name-Secret» entsprechen.
			(z.B. "privat-notizen-123456").
			<ul>
				<li><b>Gruppe</b>: Die Namen der Gruppen sind fest vorgegeben. 
					Alle verfügbaren Gruppen sind im Auswahlfeld hinterlegt.
					Neue Gruppen werden nach Absprache eingerichtet.</li>
				<li><b>Name</b>: Der Name kann frei gewählt werden. 
					Der Name sollte möglichst keine Sonderzeichen enthalten,
					um eine gültigen Aufruflink für das Etherpad zu erzeugen.</li>
				<li><b>Secret</b>: Das Secret ist eine zufällige Zeichenkette
					die verhindern soll, dass die Adresse des Etherpads leicht 
					zu erraten ist. Sie wird automatisch generiert.</li>
			</ul>
		</p><p>
			Die Anlage neuer Etherpads auf dem Server 
			<a class="w3-tag" href="https://pad.hwn.de" target="{{site.target}}">pad.hwn.de</a> 
			ist vorübergehen gesperrt.
			Neue Etherpads können derzeit nur  über dieses Formular vorgenommen werden.
			der Aufruf bestehender Etherpads ist weiterhin direkt möglich.
			Sobald alle vorhandenen Etherpads auf das neue Namen-Schema umgestellt sind
			und die automatische Bereinigung in Betrieb ist, können Etherpads auch wieder direkt angelegt werden.
		</p>
	</details>
			
<script>

function normalizeGermanChars(str) {
    return str
        // Vorumwandlung für deutsche Sonderfälle
        .replace(/ä/g, 'ae')
        .replace(/ö/g, 'oe')
        .replace(/ü/g, 'ue')
        .replace(/ß/g, 'ss')
        .replace(/Ä/g, 'Ae')
        .replace(/Ö/g, 'Oe')
        .replace(/Ü/g, 'Ue')
        .normalize('NFKD')					// Decompose
        .replace(/[\u0300-\u036f]/g, '');	// Remove accents
}

function randomString(length = {{secret.len}}) {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789'; /* I l and O 0 removed */
  return Array.from({length}, () => 
    chars[Math.floor(Math.random() * chars.length)]
  ).join('');
}

function etherpadName (group="", name="", secret = "") {
	if (!name || !group || !secret) return "… unvollständig …";
	if (name.length < {{name.min}}) return "… Name zu kurz …";
	if (secret.length < {{secret.min}}) return "… Secret zu kurz …";
	return group + '-' + name + '-' + secret;
}

document.addEventListener("DOMContentLoaded", function() {
	const VALID_PATTERN = /^[a-zA-Z0-9_.]*$/;
	const padForm = document.getElementById('newpadForm');
	const padGroup = document.getElementById('newpadGroup');
	const padName = document.getElementById('newpadName');
	const padSecret = document.getElementById('newpadSecret');
	const padEther = document.getElementById('newpadEther');
	const padURL = document.getElementById('newpadURL');
	const padResult = document.getElementById('newpadResult');
	const buttonSubmit = document.getElementById('newpadSubmit');
	const buttonOpen = document.getElementById('newpadOpen');
	padResult.textContent = "… wartet …";
	
	function setFormValues() {
		padEther.value = etherpadName(padGroup.value, padName.value, padSecret.value);
		padURL.value = (padEther.value.charAt(0) == `…`)	? "" : '{{ site.var.PAD_PADURL }}/' + padEther.value;
		buttonSubmit.disabled = buttonOpen.disabled = (padURL.value == "");
	}

/** INIT OF FORM **/
	if (! padForm) {
		console.log (padForm, document.getElementById('newpadForm'), padResult);
		alert("Es gibt technische Probleme mit dem Formular, welche leider verhindern, dass ein Etherpad angelegt werden kann werden kann.");
		padResult.innerHTML = "<b class='w3-text-red'>Fehler im Formular!</b>";
		window.location.assign("/"); // go back, if failing
		return;
	}
	if (padSecret.value == "") padSecret.value = randomString({{secret.init}});
	setFormValues();

/** PADGROUP **/
	padGroup.addEventListener("change", function(e) {
		setFormValues();
	});

	
/** PADNAME **/
	padName.addEventListener("input", function(e) {		// Prevent bad input
		const value = normalizeGermanChars(e.target.value);
		e.target.value = value.replace(/[^a-zA-Z0-9_.]/g, "");
	});
	padName.addEventListener("blur", function(e) {		// Validate on blur/change
		if (e.target.value && !VALID_PATTERN.test(e.target.value)) {
			e.target.setCustomValidity("Nur Buchstaben, Zahlen, . und _ erlaubt");
			e.target.reportValidity();
		} else {
			e.target.setCustomValidity("");
		}
	});
	padName.addEventListener("input", function() {		// Clear validation message when user starts typing again
		this.setCustomValidity("");
		setFormValues();
	});	
	
/** PADSECRET **/
	padSecret.addEventListener("input", function(e) {		// Prevent bad input
		e.target.value = e.target.value.replace(/[^a-zA-Z0-9_.]/g, "");
	});
	padSecret.addEventListener("blur", function(e) {		// Validate on blur/change
		if (e.target.value && !VALID_PATTERN.test(e.target.value)) {
			e.target.setCustomValidity("Nur Buchstaben, Zahlen, . und _ erlaubt");
			e.target.reportValidity();
		} else {
			e.target.setCustomValidity("");
		}
	});
	padSecret.addEventListener("input", function() {		// Clear validation message when user starts typing again
		this.setCustomValidity("");
		setFormValues();
	});	

/** PADRECYCLE **/	
	document.getElementById('newpadRecycle').addEventListener("click", async function(event) {
		padSecret.value = randomString();
		setFormValues();
	});	

/** SUBMIT **/
    padForm.addEventListener("submit", async function(event) {
        event.preventDefault();
        
        function resultMessage(code, text) {
			return '<span class="w3-margin.left';
		}
        

        // 1. Initial State
        padResult.textContent = "… in Arbeit …";	
		buttonSubmit.disabled = buttonOpen.disabled = true;
		console.log ("Submit: Name=", padEther.value)
		
        // 2. Create Etherpad - // symbols ✅⚠️⛔ 🗑️
        let result = etherpad.create(padEther.value);
		result.then ( function(result) {
				if (result.code == 0) {
					padResult.innerHTML = `✅ <b class="w3-text-green">Neues Etherpad wurde erzeugt.</b>` +
								((result.data) ? `<br><span class="w3-text-dark-gray">🗑️ Lösch-Token: <b class="w3-monospace">${result.data.deletionToken}</b></span>` : '');
					console.log("🗑", result.data.deletionToken);
				} else if (result.code == 1) {
					if (result.message.includes("padID does already exist")) {
						window.open(padURL.value, "{{site.target}}").focus();
						padResult.innerHTML = `⚠️ <b class="w3-text-orange">Vorhandenes Etherpad wurde geöffnet.</b>`;
					} else {
						padResult.innerHTML = `⛔ <b class="w3-text-orange">Fehler #1: ${result.message}</b>`;
					}
				} else padResult.innerHTML = `⛔ <b class="w3-text-red">Fehler #${result.code}: ${result.message}</b>`;  
			})
			//~ .catch( (error) {
				//~ padResult.innerHTML = `⛔ <b class="w3-red">${error.message}</b>`;
			//~ });
        //~ alert("Diese Funktion steht leider noch nicht zur Verfügung.");
		buttonSubmit.disabled = buttonOpen.disabled = (padURL.value == "");
	});
/** OPEN **/
    buttonOpen.addEventListener("click", function(event) {
        event.preventDefault();

        // 1. Initial State
        padResult.textContent = "… in Arbeit …";	
		buttonSubmit.disabled = buttonOpen.disabled = true;
        window.open(padURL.value, "{{site.target}}").focus()
        padResult.innerHTML = `✅  <b class="w3-text-green">Etherpad "${padEther.value}" wurde geöffnet.</b>`;
        //~ alert("Diese Funktion steht leider noch nicht zur Verfügung.\n" + padEther.value + "\n{{site.target}}");
		buttonSubmit.disabled = buttonOpen.disabled = (padURL.value == "");
	});
});

</script>		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		

</main>
