<style>
/* äußere Reihe: legt die Cards nebeneinander */
.card-row {
  display: grid;
  gap: 0em;
  grid-template-columns: repeat(auto-fit, minmax(18em, 1fr));
}

/* jede Card: Bild + Text nebeneinander, vertikal zentriert */
.card {
	padding: 4px;
  display: flex;
  align-items: center;
  gap: 1em;
  flex: 1 1 18em;           /* Basisbreite ~18em, darf wachsen/schrumpfen */
  cursor: pointer;
  /* w3-sand etc. bleibt als Klasse dran */
}

.card-logo {
	margin-left: 8px;
  width: 8rem;
  flex: 0 0 auto;
}

.card h1 {
  margin: 0;
  font-size: 1.5rem;        /* h1 ist sonst sehr groß, sprengt die Karte */
}
</style>

<main>
<div class="card-row">
	{% for card in lectures %}
		<div class="card w3-{{card.color}}"
			 onclick="location.href='{{card.url}}';">
		<img src="/static/img/logo/{{card.logo}}" alt="{{card.logo_alt}}" class="card-logo" style="width:{{card.logo_width|d('8rem')}}">
		<h1>{{card.caption}}</h1>
		</div>
	{% endfor %}	

</main>

